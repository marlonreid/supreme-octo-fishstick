int captureHeight = await mainPage.EvaluateAsync<int>(@"([currentY, maxCaptureHeight]) => {
    let safeBottomY = currentY + maxCaptureHeight;
    const originalSafeBottom = safeBottomY;
    
    // Grab elements. Note: Removed generic wrapper classes like .radio-group if they are massive.
    // We only care about slicing the actual text or the actual input buttons.
    const elements = document.querySelectorAll('p, input, select, textarea, label, img, table, tr, button, h1, h2, h3, h4, span');
    
    for (const el of elements) {
        const rect = el.getBoundingClientRect();
        
        // Since we aren't physically scrolling the window, rect.top + window.scrollY gives us the true, fixed absolute Y coordinate.
        const absoluteTop = rect.top + window.scrollY;
        const absoluteBottom = rect.bottom + window.scrollY;

        // Does the proposed cut-line slice directly through this element?
        if (absoluteTop < safeBottomY && absoluteBottom > safeBottomY) {
            
            // CRITICAL CHECK: Does this element actually start on the CURRENT page?
            // If it started on a previous page (absoluteTop < currentY), it is a massive element 
            // and we are forced to slice it. 
            if (absoluteTop >= currentY) {
                // It starts on this page, so we can safely push the cut-line up to save it!
                safeBottomY = absoluteTop - 5; 
            }
        }
    }
    
    let calculatedHeight = safeBottomY - currentY;

    // FAILSAFE: If a cluster of elements pushed our cut-line up so high that we are making 
    // zero progress (e.g. less than 100px), just force the cut at the max height to prevent infinite loops.
    if (calculatedHeight < 100) {
        return maxCaptureHeight;
    }
    
    return calculatedHeight;

}", new[] { currentY, Math.Min(targetPageHeight, totalHeight - currentY) });
