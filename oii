using System;
using System.Collections.Generic;
using System.Threading.Tasks;
using Microsoft.Playwright;

public async IAsyncEnumerable<byte[]> ConvertToPaddedSmartPagesAsync(IBrowserContext context, string htmlContent, string baseUrl)
{
    var mainPage = await context.NewPageAsync();
    // Create a second "Stamper" page specifically for padding the images
    var paddingPage = await context.NewPageAsync();

    try
    {
        int pageWidth = 794;  
        int targetPageHeight = 1123; 
        
        await mainPage.SetViewportSizeAsync(pageWidth, targetPageHeight);
        await paddingPage.SetViewportSizeAsync(pageWidth, targetPageHeight);

        // Load your HTML flawlessly into the main page
        string fixedHtml = $"<base href='{baseUrl}'>\n" + htmlContent;
        await mainPage.SetContentAsync(fixedHtml, new PageSetContentOptions { WaitUntil = WaitUntilState.NetworkIdle });

        int totalHeight = await mainPage.EvaluateAsync<int>("document.documentElement.scrollHeight");
        int currentY = 0;

        while (currentY < totalHeight)
        {
            // 1. Calculate the safe cut-line (same as before)
            int captureHeight = await mainPage.EvaluateAsync<int>(@"([currentY, maxCaptureHeight]) => {
                let safeBottomY = currentY + maxCaptureHeight;
                const elements = document.querySelectorAll('p, input, select, textarea, label, img, table, tr, button, .radio-group, h1, h2, h3');
                
                for (const el of elements) {
                    const rect = el.getBoundingClientRect();
                    const absoluteTop = currentY + rect.top;
                    const absoluteBottom = currentY + rect.bottom;

                    if (absoluteTop < safeBottomY && absoluteBottom > safeBottomY) {
                        safeBottomY = absoluteTop - 5; 
                    }
                }
                return Math.max(100, safeBottomY - currentY);
            }", new[] { currentY, Math.Min(targetPageHeight, totalHeight - currentY) });

            // 2. Take the raw (potentially short) screenshot
            var imageBytes = await mainPage.ScreenshotAsync(new PageScreenshotOptions
            {
                Type = ScreenshotType.Png,
                Clip = new Clip { X = 0, Y = currentY, Width = pageWidth, Height = captureHeight }
            });

            // 3. THE PADDING STEP: If the image is shorter than our target page height, pad it with white space
            if (captureHeight < targetPageHeight)
            {
                // Convert the short image to Base64
                string base64Image = Convert.ToBase64String(imageBytes);
                
                // Inject it into our locked 1123px high Stamper page
                await paddingPage.SetContentAsync($@"
                    <style>
                        body {{ margin: 0; padding: 0; background-color: white; }}
                        img {{ display: block; vertical-align: top; }}
                    </style>
                    <img src='data:image/png;base64,{base64Image}' />
                ");

                // Take a screenshot of the padded page. It will be exactly 794x1123 every time.
                imageBytes = await paddingPage.ScreenshotAsync(new PageScreenshotOptions { Type = ScreenshotType.Png });
            }

            // Yield the final, perfectly sized, perfect fidelity image
            yield return imageBytes;

            currentY += captureHeight;
        }
    }
    finally
    {
        await mainPage.CloseAsync();
        await paddingPage.CloseAsync();
    }
}
