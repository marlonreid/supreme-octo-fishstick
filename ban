var result = await page.EvaluateAsync<JsonElement>(@"(targetH) => {
    try {
        const result = [0];
        let currentY = 0;
        const totalH = document.documentElement.scrollHeight;

        while (currentY + targetH < totalH) {
            let idealBreak = currentY + targetH;
            let safeBreak = idealBreak;

            const elements = document.querySelectorAll('p, input, select, label, img, tr, h1, h2, h3, span, div');

            for (const el of elements) {
                if (!el) continue;

                const style = window.getComputedStyle(el);
                if (style.display === 'none' || style.visibility === 'hidden') continue;

                const rect = el.getBoundingClientRect();
                if (!rect || rect.height === 0 || rect.width === 0) continue;

                const top = rect.top + window.scrollY;
                const bottom = rect.bottom + window.scrollY;

                if (top < idealBreak && bottom > idealBreak) {
                    if (top > currentY + 100) {
                        safeBreak = Math.floor(top - 2);
                        break;
                    }
                }
            }

            if (safeBreak <= currentY) safeBreak = currentY + targetH;
            result.push(safeBreak);
            currentY = safeBreak;
        }

        result.push(totalH);
        return { ok: true, breakPoints: result };

    } catch (e) {
        return {
            ok: false,
            error: e.message,
            stack: e.stack,
            // Dump useful DOM state at time of failure
            scrollHeight: document.documentElement?.scrollHeight,
            elementCount: document.querySelectorAll('p, input, select, label, img, tr, h1, h2, h3, span, div')?.length
        };
    }
}", targetHeight);

if (!result.GetProperty("ok").GetBoolean())
{
    var error = result.GetProperty("error").GetString();
    var stack = result.GetProperty("stack").GetString();
    throw new InvalidOperationException($"JS breakpoint calculation failed:\n{error}\n{stack}");
}

var breakPoints = result.GetProperty("breakPoints")
    .EnumerateArray()
    .Select(x => x.GetInt32())
    .ToList();
