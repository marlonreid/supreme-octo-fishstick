public async IAsyncEnumerable<byte[]> HtmlToPagedImagesAsync(string htmlContent, string baseUrl)
{
    var page = await _browser.NewPageAsync();
    
    try 
    {
        int pageWidth = 794;  
        int targetHeight = 1123; 
        await page.SetViewportSizeAsync(pageWidth, 800);

        string fixedHtml = $"<base href='{baseUrl}'>\n" + htmlContent;
        await page.SetContentAsync(fixedHtml, new PageSetContentOptions { WaitUntil = WaitUntilState.NetworkIdle });
        
        // Wait for fonts, but don't hang if they fail
        await page.EvaluateAsync("() => document.fonts?.ready || Promise.resolve()");

        // 1. HARDENED STATE SCRUBBER (Neutralizes browser 'helpfulness')
        await page.EvaluateAsync(@"() => {
            // Safe Dropdown Fix
            document.querySelectorAll('select').forEach(s => {
                if (!s || !s.options) return;
                const optionsArray = Array.from(s.options);
                const hasSelected = optionsArray.some(o => o && o.hasAttribute('selected'));
                if (!hasSelected) s.selectedIndex = -1;
            });

            // Safe Radio/Checkbox Fix
            document.querySelectorAll('input[type=""radio""], input[type=""checkbox""]').forEach(i => {
                if (i) i.checked = i.hasAttribute('checked');
            });

            // Safe Blur (prevents orange focus rings)
            if (document.activeElement && typeof document.activeElement.blur === 'function') {
                document.activeElement.blur();
            }
        }");

        // 2. HARDENED RAYCASTER (Calculates Breakpoints)
        var breakPoints = await page.EvaluateAsync<List<int>>(@"([targetH]) => {
            const points = [0];
            let currentY = 0;
            const docEl = document.documentElement;
            const totalH = docEl ? docEl.scrollHeight : 5000; // Fallback if docEl is null

            while (currentY + targetH < totalH) {
                let idealBreak = currentY + targetH;
                let safeBreak = idealBreak;

                // Look for elements crossing the line
                const elements = document.querySelectorAll('p, input, select, label, img, tr, h1, h2, h3, span, div');
                for (const el of elements) {
                    if (!el) continue;
                    const rect = el.getBoundingClientRect();
                    if (!rect) continue;

                    const top = rect.top + window.scrollY;
                    const bottom = rect.bottom + window.scrollY;

                    // If slicing through element, push break point UP to its top
                    if (top < idealBreak && bottom > idealBreak) {
                        if (top > currentY + 100) {
                            safeBreak = Math.floor(top - 5);
                        }
                    }
                }
                
                // Safety: If safeBreak didn't move forward, force progress to avoid infinite loop
                if (safeBreak <= currentY) safeBreak = currentY + targetH;
                
                points.push(safeBreak);
                currentY = safeBreak;
            }
            points.push(totalH);
            return points;
        }", new[] { targetHeight });

        // 3. MASTER CAPTURE
        byte[] masterBytes = await page.ScreenshotAsync(new PageScreenshotOptions { FullPage = true, Type = ScreenshotType.Png });
        
        // 4. IMAGE SLICING (In Memory)
        using var masterImage = Image.Load<Rgba32>(masterBytes);

        for (int i = 0; i < breakPoints.Count - 1; i++)
        {
            int yStart = breakPoints[i];
            int yEnd = breakPoints[i + 1];
            int sliceHeight = yEnd - yStart;

            // Sanity check: Ensure slice is at least 1px and within image bounds
            if (sliceHeight <= 0 || yStart + sliceHeight > masterImage.Height) continue;

            var cropArea = new Rectangle(0, yStart, masterImage.Width, sliceHeight);
            using var slice = masterImage.Clone(ctx => ctx.Crop(cropArea));

            // Stamp onto white A4 canvas
            using var canvas = new Image<Rgba32>(pageWidth, targetHeight);
            canvas.Mutate(ctx => {
                ctx.BackgroundColor(Color.White);
                ctx.DrawImage(slice, new Point(0, 0), 1f);
            });

            using var ms = new MemoryStream();
            await canvas.SaveAsPngAsync(ms);
            yield return ms.ToArray();
        }
    }
    finally 
    {
        await page.CloseAsync();
    }
}
