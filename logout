<?php
session_start();

// --- CONFIGURATION ---
$keycloak_url = "https://<your-keycloak-domain>/realms/<your-realm>";

// Where should Keycloak send the user AFTER they are logged out?
$post_logout_redirect_uri = "http://localhost:8000/login.php"; 
// ---------------------

// 1. Grab the ID token we saved during login
$id_token = $_SESSION['id_token'] ?? null;

// 2. Destroy the local PHP session
session_unset();
session_destroy();

// 3. If we don't have an ID token, just redirect to login locally
if (!$id_token) {
    header("Location: " . $post_logout_redirect_uri);
    exit;
}

// 4. Build the Keycloak Logout URL
$logout_endpoint = $keycloak_url . "/protocol/openid-connect/logout";

$logout_url = $logout_endpoint . "?" . http_build_query([
    'post_logout_redirect_uri' => $post_logout_redirect_uri,
    'id_token_hint'            => $id_token
]);

// 5. Redirect the browser to Keycloak
header("Location: " . $logout_url);
exit;
