var debug = await page.EvaluateAsync<object>(@"() => {
    const insertedPre = document.querySelector('pre.ide-content-section');
    const preRect = insertedPre.getBoundingClientRect();
    const style = window.getComputedStyle(insertedPre);
    
    const ancestors = [];
    let el = insertedPre.parentElement;
    while (el && el !== document.body) {
        const s = window.getComputedStyle(el);
        ancestors.push({
            class: el.className,
            paddingLeft: s.paddingLeft,
            paddingRight: s.paddingRight,
            marginRight: s.marginRight
        });
        el = el.parentElement;
    }

    return {
        preLeft: preRect.left,
        paddingLeft: style.paddingLeft,
        paddingRight: style.paddingRight,
        borderRight: style.borderRightWidth,
        marginRight: style.marginRight,
        ancestors
    };
}");

Console.WriteLine(System.Text.Json.JsonSerializer.Serialize(debug));
