const insertedPre = document.querySelector('pre.ide-content-section:not([data-required-width])');
const style = window.getComputedStyle(insertedPre);

const span = document.createElement('span');
span.style.cssText = 'position:absolute; top:-9999px; left:0; visibility:hidden; white-space:pre;';
span.style.font = style.font;
span.style.letterSpacing = style.letterSpacing;
span.style.tabSize = style.tabSize;
document.body.appendChild(span);

const lines = insertedPre.textContent.split('\n');
let maxWidth = 0;
lines.forEach(line => {
    span.textContent = line;
    maxWidth = Math.max(maxWidth, span.getBoundingClientRect().width);
});

document.body.removeChild(span);

const preLeft = insertedPre.getBoundingClientRect().left;
const requiredWidth = Math.ceil(preLeft + maxWidth);
insertedPre.setAttribute('data-required-width', requiredWidth);
